{
  "type": "object",
  "required": [
    "contract_version",
    "detected",
    "overrides",
    "max_fix_attempts",
    "max_review_rounds",
    "baseline_snapshot",
    "start_timeout",
    "untracked_policy",
    "min_review_level",
    "auto_branch",
    "branch_prefix"
  ],
  "properties": {
    "contract_version": { "const": 1 },
    "source_fingerprint": { "type": "string" },
    "detected": {
      "type": "object",
      "properties": {
        "package_manager": { "type": ["string", "null"] },
        "test": { "type": ["string", "null"] },
        "build": { "type": ["string", "null"] },
        "start": { "type": ["string", "null"] },
        "lint": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "overrides": { "type": "object", "additionalProperties": true },
    "max_fix_attempts": { "type": "integer" },
    "max_review_rounds": { "type": "integer" },
    "baseline_snapshot": { "type": "boolean" },
    "deploy_check_cmd": { "type": ["string", "null"] },
    "start_check_cmd": { "type": ["string", "null"] },
    "start_timeout": { "type": "integer" },
    "trunk": { "type": ["string", "null"] },
    "untracked_policy": { "enum": ["baseline", "strict"] },
    "min_review_level": { "enum": ["low", "medium", "high", "critical"] },
    "auto_branch": { "type": "boolean" },
    "branch_prefix": { "type": "string" },
    "headless_max_turns": { "type": "integer" },
    "headless_timeout_minutes": { "type": "integer" },
    "noncode_globs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metadata_json_allowlist": {
      "description": "Structured, per-file sibling to noncode_globs for JSON manifests that mix pure metadata with real config (package.json, plugin manifests, ...). Each entry names a glob and the top-level JSON keys that are safe to change without triggering a code review — e.g. a version bump. A changeset touching one of these files is treated as non-code ONLY when every top-level key that differs between base and head is in that entry's keys list; any other change (a new dependency, a script, a permission) still gates normally.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["glob", "keys"],
        "properties": {
          "glob": { "type": "string" },
          "keys": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "worktree": {
      "description": "Worktree provisioning block, owned by worktree-detect.sh. Independently fingerprinted from the top-level detected block so the two never invalidate each other. detected.setup_cmd is ALWAYS null; a runnable setup command only ever comes from overrides.setup_cmd, set by a human.",
      "type": "object",
      "properties": {
        "source_fingerprint": { "type": "string" },
        "detected": { "type": "object", "additionalProperties": true },
        "overrides": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
