{
  "type": "object",
  "required": ["contract_version", "task_key", "steps"],
  "properties": {
    "contract_version": { "const": 1 },
    "task_key": { "type": "string" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "ref"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "status": { "enum": ["applicable", "excluded"] },
          "ref": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
